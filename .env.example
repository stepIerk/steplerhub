# Ключи проекта Supabase (Dashboard → Project Settings → API).
# Скопируйте этот файл в `.env.local` и вставьте свои значения.
# `.env.local` уже закрыт от git через `.gitignore` (*.local).
VITE_SUPABASE_URL=https://xyzcompany.supabase.co
# Любой один из двух ключей (Project Settings → API):
# классический anon key (JWT) или новый publishable key (sb_publishable_...)
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
